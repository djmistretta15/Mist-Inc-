# Database
DATABASE_URL=postgresql://mist:mist_dev_password@localhost:5432/mist

# Redis
REDIS_URL=redis://localhost:6379

# Identity Service
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# Payments
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Trust Engine
TRUST_DECAY_RATE=0.005  # 0.5% per week
TRUST_MIN_TRANSACTIONS=5

# Scheduler
SCHEDULER_MAX_RETRIES=3
SCHEDULER_TIMEOUT_SECONDS=300

# Compliance
AUDIT_RETENTION_DAYS=2555  # 7 years
GDPR_ENABLED=true

# Analytics
ML_MODEL_UPDATE_INTERVAL=3600  # 1 hour
ANOMALY_THRESHOLD=0.85
